# Copy to .env. Install/update scripts preserve an existing .env.
# Keep this name when migrating an existing deployment to retain its volumes.
COMPOSE_PROJECT_NAME=qqbot-napcat

# Published backend image; init and bot always use the same image.
BOT_IMAGE=cjzwr/qqbot-napcat:1.1.10
# The existing 1.1.10 tag has AMD64 only. After an ARM64 image is published,
# ARM64 hosts can set this to linux/arm64 for native execution.
BOT_PLATFORM=linux/amd64
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest

# Host ports only; internal API remains napcat:3000.
BIND_ADDRESS=127.0.0.1
BOT_PORT=8881
NAPCAT_WEBUI_PORT=6099
TZ=Asia/Shanghai

# Leave empty to follow the account saved in the bot console.
# If set, overrides the console. Changes here need `docker compose up -d`.
NAPCAT_ACCOUNT=
